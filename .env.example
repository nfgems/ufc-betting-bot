# The Odds API key (get free key at https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Optional Best Fight Odds method-props collection controls
METHOD_ODDS_BFO_REQUEST_TIMEOUT_SECONDS=20
METHOD_ODDS_BFO_MAX_RETRIES=3
METHOD_ODDS_BFO_RETRY_BACKOFF_SECONDS=3
METHOD_ODDS_BFO_FAILURE_BUDGET=3
METHOD_ODDS_COLLECTION_MAX_ATTEMPTS=3
METHOD_ODDS_EXPECTED_WINDOW_HOURS=48

# Polymarket
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polymarket_proxy_wallet_address
POLYMARKET_CLOB_URL=
POLYMARKET_BUILDER_CODE=
CLOB_PROXY_URL=http://user:pass@host:port
POLYMARKET_GEOBLOCK_TIMEOUT_SECONDS=4.0
POLYMARKET_CLOB_CONNECT_TIMEOUT_SECONDS=3
POLYMARKET_CLOB_READ_TIMEOUT_SECONDS=10
POLYMARKET_CLOB_WRITE_TIMEOUT_SECONDS=5
POLYMARKET_CLOB_POOL_TIMEOUT_SECONDS=2
POLYMARKET_BALANCE_MAX_ATTEMPTS=3
# Must be finite and nonnegative.
POLYMARKET_BALANCE_RETRY_BACKOFF_SECONDS=0.5
# Soft deadlines for admitting retries; active HTTP phases have their own limits.
POLYMARKET_BALANCE_TOTAL_BUDGET_SECONDS=25
POLYMARKET_OPEN_ORDERS_TOTAL_BUDGET_SECONDS=25
POLYMARKET_OPEN_ORDERS_MAX_ATTEMPTS=2
POLYMARKET_OPEN_ORDERS_RETRY_BACKOFF_SECONDS=0.5

# Optional: redeem resolved winnings through the Polymarket relayer
POLYMARKET_AUTO_REDEEM=0
POLYMARKET_AUTO_REDEEM_COOLDOWN_HOURS=6
POLYMARKET_AUTO_REDEEM_PENDING_TTL_HOURS=24
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Hosted dashboard mutations
WEB_DASHBOARD_TOKEN=change_me

# Activity dashboard durable alert retention (hours; clamped to a 1-hour minimum)
ACTIVITY_ALERT_RETENTION_HOURS=72

# Persistent line-history retention and optional S3-compatible archive.
# On Railway, set archive values with references to a private Storage Bucket.
LINE_HISTORY_RETENTION_DAYS=180
# Preserve expired snapshots instead of deleting them when no archive bucket is
# configured. This is forced on in Railway production even when explicitly set to 0.
LINE_HISTORY_ARCHIVE_REQUIRED=0
LINE_HISTORY_ARCHIVE_BUCKET=
LINE_HISTORY_ARCHIVE_ENDPOINT=
LINE_HISTORY_ARCHIVE_REGION=auto
LINE_HISTORY_ARCHIVE_ACCESS_KEY_ID=
LINE_HISTORY_ARCHIVE_SECRET_ACCESS_KEY=
LINE_HISTORY_ARCHIVE_PREFIX=ufc/line-history/v1
LINE_HISTORY_ARCHIVE_URL_STYLE=virtual

# Slow-growing historical snapshots keep recent full resolution, then one
# snapshot per UTC day until their hard retention limit.
RANKINGS_SNAPSHOT_RETENTION_DAYS=400
RANKINGS_SNAPSHOT_FULL_RESOLUTION_DAYS=30
RANKINGS_SNAPSHOT_DAILY_KEEP=1
RANKINGS_SNAPSHOT_PRUNE_INTERVAL_SECONDS=3600
METHOD_ODDS_SNAPSHOT_RETENTION_DAYS=180
METHOD_ODDS_SNAPSHOT_FULL_RESOLUTION_DAYS=14
METHOD_ODDS_SNAPSHOT_DAILY_KEEP=1
METHOD_ODDS_SNAPSHOT_PRUNE_INTERVAL_SECONDS=3600

# Other persistent histories.
OPERATOR_DECISION_LOG_MAX_BYTES=52428800
OPERATOR_DECISION_READ_LIMIT=25000
CARD_SNAPSHOT_PAST_EVENT_RETENTION_DAYS=30
CARD_SNAPSHOT_UNKNOWN_DATE_RETENTION_DAYS=180
CARD_SNAPSHOT_MAX_PER_EVENT=64
CARD_SNAPSHOT_MAX_FILES=1000
CARD_SNAPSHOT_PRUNE_INTERVAL_SECONDS=3600

# BetsAPI (optional — enables MMA odds from BetsAPI)
BETSAPI_TOKEN=
BETSAPI_REQUEST_MIN_INTERVAL_SECONDS=1
BETSAPI_429_RETRY_MIN_SECONDS=15

# Chain ID (default: 137 for Polygon mainnet)
POLYMARKET_CHAIN_ID=137

# Hosted live-trading policy
LIVE_TRADING_MODE=off
LIVE_MODEL=xgboost
LIVE_TRADING_ARMED=0
LIVE_TRADING_CONFIRMATION=
BTC5M_REAL_TRADING_WINDOW_ENABLED=1
BTC5M_REAL_TRADING_WINDOW_TIMEZONE=America/New_York
BTC5M_REAL_TRADING_START_HOUR=9
BTC5M_REAL_TRADING_END_HOUR=17

# Optional: Gemini key for UFC operator synthesis
GEMINI_API_KEY=
GEMINI_OPERATOR_MODEL=
GEMINI_OPERATOR_FALLBACK_MODELS=
GEMINI_OPERATOR_PRIMARY_MODEL_RETRIES=
GEMINI_OPERATOR_FALLBACK_RETRIES_PER_MODEL=
GEMINI_TRACKER_CONFIDENCE_CAP=0.85

# Docker/Railway entrypoint role (web or ufc-refresh-scheduled)
APP_ROLE=web

# Optional: hosted UFC data refresh loop for Railway / always-on deployments
UFC_REFRESH_ENABLED=0
UFC_REFRESH_INTERVAL_HOURS=24
UFC_REFRESH_INITIAL_DELAY_MINUTES=30
UFC_REFRESH_LIMIT_FIGHTERS=
UFC_REFRESH_NEW_FIGHTER_ALERT_GRACE_DAYS=7
# Optional: supplement new active-fighter profile gaps during scheduled refresh
UFC_REFRESH_PROFILE_SUPPLEMENT_ENABLED=1
UFC_REFRESH_PROFILE_SUPPLEMENT_LIMIT=
# Comma-separated subset of martialbot,fightdx,espn,tapology,sherdog,wikipedia
UFC_REFRESH_PROFILE_SUPPLEMENT_SOURCES=
UFC_REFRESH_MIN_OVERALL_REACH_PCT=
UFC_REFRESH_MIN_OVERALL_STANCE_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_REACH_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_STANCE_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_FULL_PHYSICAL_PCT=
UFC_REFRESH_MAX_RETAINED_MISSING_LIVE_ROWS=50
UFC_REFRESH_MAX_RETAINED_MISSING_LIVE_PCT=5.0
TAPOLOGY_PROXY_URL=
TAPOLOGY_READER_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_HTML_FALLBACK_ENABLED=0
BRAVE_SEARCH_TIMEOUT_SECONDS=12
