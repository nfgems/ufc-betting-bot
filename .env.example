# The Odds API key (get free key at https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Polymarket
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polymarket_proxy_wallet_address
POLYMARKET_CLOB_URL=
POLYMARKET_BUILDER_CODE=
CLOB_PROXY_URL=http://user:pass@host:port

# Optional: redeem resolved winnings through the Polymarket relayer
POLYMARKET_AUTO_REDEEM=0
POLYMARKET_AUTO_REDEEM_COOLDOWN_HOURS=6
POLYMARKET_AUTO_REDEEM_PENDING_TTL_HOURS=24
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Hosted dashboard mutations
WEB_DASHBOARD_TOKEN=change_me

# BetsAPI (optional — enables MMA odds from BetsAPI)
BETSAPI_TOKEN=
BETSAPI_REQUEST_MIN_INTERVAL_SECONDS=1
BETSAPI_429_RETRY_MIN_SECONDS=15

# Chain ID (default: 137 for Polygon mainnet)
POLYMARKET_CHAIN_ID=137

# Hosted live-trading policy
LIVE_TRADING_MODE=off
LIVE_MODEL=xgboost
LIVE_TRADING_ARMED=0
LIVE_TRADING_CONFIRMATION=

# Optional: Gemini key for UFC operator synthesis
GEMINI_API_KEY=
GEMINI_OPERATOR_MODEL=
GEMINI_OPERATOR_FALLBACK_MODELS=
GEMINI_OPERATOR_PRIMARY_MODEL_RETRIES=
GEMINI_OPERATOR_FALLBACK_RETRIES_PER_MODEL=

# Optional: hosted UFC data refresh loop for Railway / always-on deployments
UFC_REFRESH_ENABLED=0
UFC_REFRESH_INTERVAL_HOURS=168
UFC_REFRESH_INITIAL_DELAY_MINUTES=30
UFC_REFRESH_LIMIT_FIGHTERS=
UFC_REFRESH_NEW_FIGHTER_ALERT_GRACE_DAYS=7
# Optional: supplement new active-fighter profile gaps during scheduled refresh
UFC_REFRESH_PROFILE_SUPPLEMENT_ENABLED=1
UFC_REFRESH_PROFILE_SUPPLEMENT_LIMIT=
# Comma-separated subset of martialbot,fightdx,espn,tapology,sherdog,wikipedia
UFC_REFRESH_PROFILE_SUPPLEMENT_SOURCES=
UFC_REFRESH_MIN_OVERALL_REACH_PCT=
UFC_REFRESH_MIN_OVERALL_STANCE_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_REACH_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_STANCE_PCT=
UFC_REFRESH_MIN_NEW_FIGHTER_FULL_PHYSICAL_PCT=
