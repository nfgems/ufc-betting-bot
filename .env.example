# The Odds API key (get free key at https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Polymarket
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polymarket_proxy_wallet_address
CLOB_PROXY_URL=http://user:pass@host:port

# Optional: redeem resolved winnings through the Polymarket relayer
POLYMARKET_AUTO_REDEEM=0
POLYMARKET_AUTO_REDEEM_COOLDOWN_HOURS=6
POLYMARKET_AUTO_REDEEM_PENDING_TTL_HOURS=24
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# Use either Builder credentials...
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# ...or direct Relayer API key credentials.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Hosted dashboard mutations
WEB_DASHBOARD_TOKEN=change_me

# BetsAPI (optional — enables MMA odds from BetsAPI)
BETSAPI_TOKEN=
BETSAPI_REQUEST_MIN_INTERVAL_SECONDS=1
BETSAPI_429_RETRY_MIN_SECONDS=15

# Chain ID (default: 137 for Polygon mainnet)
POLYMARKET_CHAIN_ID=137

# Hosted live-trading policy
LIVE_TRADING_MODE=off
LIVE_MODEL=xgboost
LIVE_TRADING_ARMED=0
LIVE_TRADING_CONFIRMATION=
