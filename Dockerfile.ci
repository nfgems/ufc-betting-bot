FROM python:3.12-slim
WORKDIR /checks
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt pytest
COPY src ./src
COPY scripts ./scripts
COPY config ./config
COPY tests ./tests
COPY entrypoint.sh refresh-entrypoint.sh legacy-entrypoint.sh ./
COPY refresh_seed_manifest.json release-source-manifest.json ./
COPY tools/verify_release_source.py ./tools/verify_release_source.py
RUN python tools/verify_release_source.py
ENV LIVE_TRADING_MODE=off PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/checks
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests"]
